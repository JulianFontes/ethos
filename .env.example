# Copy to .env and fill in. .env is git-ignored; the shell scripts load it automatically.
OPENAI_API_KEY=

# Ollama: requests a loaded model serves at once (apply with `launchctl setenv`, then restart Ollama)
OLLAMA_NUM_PARALLEL=

# Hugging Face token (read access) for gated models, e.g. allenai/kaleido-large
HF_TOKEN=
